{
    "model": {
        "type": "minecraft:select",
        "property": "minecraft:component",
        "component": "custom_name",
        "cases": [
            {
                "when": "Straw Hat",
                "model": {
                    "type": "minecraft:model",
                    "model": "minecraft:item/straw_hat"
                }
            },
            {
                "when": "Gorro",
                "model": {
                    "type": "minecraft:select",
                    "property": "minecraft:display_context",
                    "cases": [
                        {
                            "when": "head",
                            "model": {
                                "type": "minecraft:model",
                                "model": "minecraft:item/gorro"
                            }
                        }
                    ],
                    "fallback": {
                        "type": "minecraft:model",
                        "model": "minecraft:item/gorro_item"
                    }
                }
            },
            {
                "when": "Builder Helmet",
                "model": {
                    "type": "minecraft:select",
                    "property": "minecraft:display_context",
                    "cases": [
                        {
                            "when": "head",
                            "model": {
                                "type": "minecraft:model",
                                "model": "minecraft:item/builder_helmet"
                            }
                        }
                    ],
                    "fallback": {
                        "type": "minecraft:model",
                        "model": "minecraft:item/builder_helmet_item"
                    }
                }
            }
        ],
        "fallback": {
            "type": "minecraft:model",
            "model": "minecraft:block/carved_pumpkin"
        }
    }
}